[Unit]
Description=entity-memory: delete expired events and facts in every domain
Documentation=https://github.com/sarbloc/memory-system-skill

[Service]
Type=oneshot
# Same env the MCP server sees (QDRANT_URL / QDRANT_API_KEY / ENTITY_MEMORY_CONFIG).
EnvironmentFile=-%h/.config/entity-memory/env
ExecStart=%h/.local/bin/memory expire --domain all
Nice=10
IOSchedulingClass=idle
