[Unit]
Description=KIPP: flush captured conversation turns into events
Documentation=https://github.com/sarbloc/kipp/blob/main/docs/capture.md

[Service]
Type=oneshot
# Same env the MCP server sees (QDRANT_URL / QDRANT_API_KEY / KIPP_CONFIG).
# The kipp file is read last, so it wins over the pre-rename one.
EnvironmentFile=-%h/.config/entity-memory/env
EnvironmentFile=-%h/.config/kipp/env
ExecStart=%h/.local/bin/kipp capture flush
Nice=10
IOSchedulingClass=idle
